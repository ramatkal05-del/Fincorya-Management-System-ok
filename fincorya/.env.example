# Copiez ce fichier vers .env et remplacez les valeurs selon l'environnement.
# Pour Render, consultez docs/deployment-render.md — la plupart de ces
# variables sont gérées automatiquement par le Blueprint (render.yaml).

# --- Application ---
DEBUG=True
ENVIRONMENT=development
MFA_ENABLED=True
LOCAL_AUTH_BYPASS=False
LOCAL_AUTH_EMAIL=admin@fincorya.local
TRUST_PROXY_HEADERS=False
BUSINESS_TIME_ZONE=Europe/Istanbul

# --- Sécurité ---
DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Render définit automatiquement RENDER_EXTERNAL_HOSTNAME ;
# ALLOWED_HOSTS et CSRF_TRUSTED_ORIGINS sont étendus en conséquence.

# --- Base de données ---
# Option A (Render, PaaS) : une URL de connexion unique.
DATABASE_URL=
# Option B (local, serveur dédié) : variables individuelles.
# Laissez DATABASE_URL vide pour utiliser ces variables.
DB_HOST=
DB_PORT=5432
DB_NAME=fincorya
DB_USER=fincorya
DB_PASSWORD=

# --- Fichiers et rapports ---
MEDIA_ROOT=media
# Dossier contenant arialn.ttf et arialnb.ttf sous licence valide.
# Laisser vide en production Linux : reportlab utilise Helvetica.
REPORT_FONT_DIR=
REPORT_RETENTION_DAYS=365

# --- Email ---
DEFAULT_FROM_EMAIL=FINCORYA <noreply@fincorya.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Moteur financier ---
# Activer uniquement après une bascule réconciliée et approuvée.
# Les tests gèrent ce flag via @override_settings ; ne pas activer
# globalement dans .env.
FINANCE_LEDGER_ENABLED=False

# --- Rapports ---
FINANCE_WEEK_START=0
REPORT_DOWNLOAD_ROLES=ADMIN,FINANCE_MANAGER,AGENT

# --- Administrateur initial ---
# Mot de passe de l'admin fincoryagroup@gmail.com créé au déploiement.
# En production, définir via le dashboard Render (secret).
# Si vide, un mot de passe temporaire est généré et affiché dans les logs.
ADMIN_PASSWORD=
