# Copiez ce fichier vers .env et remplacez les valeurs selon l'environnement.
DEBUG=True
MFA_ENABLED=True
LOCAL_AUTH_BYPASS=False
LOCAL_AUTH_EMAIL=admin@fincorya.local
TRUST_PROXY_HEADERS=False
BUSINESS_TIME_ZONE=Europe/Istanbul
DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Vide = SQLite local. Renseignez ces valeurs pour PostgreSQL.
DB_HOST=
DB_PORT=5432
DB_NAME=fincorya
DB_USER=fincorya
DB_PASSWORD=

MEDIA_ROOT=media
# Dossier contenant arialn.ttf et arialnb.ttf sous licence valide.
REPORT_FONT_DIR=
REPORT_RETENTION_DAYS=365
DEFAULT_FROM_EMAIL=FINCORYA <noreply@fincorya.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
